# SCADA Cybersecurity & Quantum Key Distribution Environment Configuration
# Copy this file to .env and adjust values for local deployment.

# Web Dashboard Settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-in-production-scada-secret-key-32b

# Database Path (relative to project root or absolute)
DATABASE_PATH=data/scada_security.db

# MQTT Broker Settings
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_KEEPALIVE=60

# Modbus TCP Settings
MODBUS_HOST=127.0.0.1
MODBUS_PORT=5020
MODBUS_SLAVE_ID=1

# Quantum Key Distribution (BB84) Simulation Settings
QBER_THRESHOLD=0.11
BB84_RAW_BITS=256
BB84_SAMPLE_RATIO=0.33

# Industrial Simulation Settings
SIMULATION_INTERVAL=1.0
RANDOM_SEED=42

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scada_security.log

# Automatic Email Security Alerts (SMTP Configuration)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@scada-security.local
SCADA_ALERT_EMAIL=
SCADA_PUBLIC_URL=http://127.0.0.1:5000

# Cross-Laptop & Network Configuration
# Set FLASK_HOST=0.0.0.0 to allow access from another laptop on the local network
# BACKEND_API_URL: Point Attacker Portal on Laptop 2 to Backend on Laptop 1 (e.g. http://192.168.1.50:5000)
BACKEND_API_URL=
# CORS allowed origins (comma-separated or * for authorized local lab testing)
CORS_ALLOWED_ORIGINS=*
# Optional authorized network subnet (e.g. 192.168.1.0/24)
AUTHORIZED_CIDR=
# Optional API key for programmatic control endpoints
SCADA_API_KEY=
# Dedicated demo account for authorized brute-force simulation
DEMO_ACCOUNT_EMAIL=demo_operator@scada.local
